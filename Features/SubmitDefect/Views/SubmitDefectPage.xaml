<Page x:Class="PackageManager.Features.SubmitDefect.Views.SubmitDefectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:button="clr-namespace:CustomControlLibrary.CustomControl.Controls.Button;assembly=CustomControlLibrary"
      xmlns:controls="clr-namespace:CustomControlLibrary.CustomControl.Controls;assembly=CustomControlLibrary"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="Page_Loaded">
    <Grid>
        <controls:CLoadingOverlay x:Name="Overlay" Message="正在处理…"
                                  OverlayDarkness="0.25"
                                  AccentBrush="DodgerBlue">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row0: 标题 + 元数据行 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="提交工作项" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <controls:CTextBlock Text="类型" Width="40" VerticalAlignment="Center" />
                        <controls:CComboBox Width="100" Height="32"
                                  ItemsSource="{Binding TypeNames}"
                                  SelectedItem="{Binding SelectedTypeName, Mode=TwoWay}" />
                        <controls:CTextBlock Text="项目" Width="40" Margin="20,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedProjectName, TargetNullValue=加载中…}" Width="160"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <controls:CTextBlock Text="迭代" Width="40" Margin="20,0,0,0" VerticalAlignment="Center" />
                        <controls:CComboBox Width="200" Height="32"
                                  ItemsSource="{Binding Iterations}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedIteration, Mode=TwoWay}" />
                        <button:CButton Content="清空重来" Width="90" Margin="20,0,0,0" Click="ClearAllButton_Click" />
                        <button:CButton Content="{Binding LoginButtonText}" Width="110" Margin="8,0,0,0" Click="LoginPingCodeButton_Click"
                                        ToolTip="登录后示意图走永久 atlas；已登录时点击切换账号" />
                    </StackPanel>
                </StackPanel>

                <!-- Row1: 主内容横向两列 -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="440" />
                    </Grid.ColumnDefinitions>

                    <!-- 左列：描述（粘贴 + 编辑）-->
                    <Border Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" CornerRadius="6"
                            AllowDrop="True" PreviewDragOver="DropZone_PreviewDragOver" PreviewDrop="DropZone_PreviewDrop">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Foreground="#888" Margin="8,6,8,4"
                                       Text="描述（在此粘贴 + 编辑：文字进这里，图/视频自动进右侧）" />
                            <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                                     Text="{Binding DescriptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="14" Padding="8"
                                     PreviewKeyDown="PasteBox_PreviewKeyDown" />
                        </DockPanel>
                    </Border>

                    <!-- 右列：标题 + 示意图 + 视频 + 选择文件 -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <!-- 标题（可编辑，无提示标签）-->
                        <TextBox Text="{Binding TitleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32" FontSize="14" Padding="6,4" VerticalContentAlignment="Center"
                                 ToolTip="标题（自动提取，可修改）" />

                        <!-- 示意图（图/动图）-->
                        <StackPanel Margin="0,12,0,0">
                            <controls:CTextBlock Text="{Binding ImagesSectionTitle}" Foreground="#888" />
                            <ItemsControl ItemsSource="{Binding Images}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,8,8" BorderBrush="#DDD" BorderThickness="1" Padding="4">
                                            <StackPanel Width="128">
                                                <Image Source="{Binding Thumbnail}" Width="120" Height="120" Stretch="Uniform" />
                                                <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="#666"
                                                           MaxWidth="120" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                <DockPanel Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#2B7FFF"
                                                               VerticalAlignment="Center" />
                                                    <button:CButton DockPanel.Dock="Right" Content="✕" Width="24" Height="20"
                                                                    HorizontalAlignment="Right" Click="RemoveImageButton_Click" Tag="{Binding}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 附件（视频 / 文件）-->
                        <StackPanel Margin="0,12,0,0">
                            <controls:CTextBlock Text="附件（视频 / 文件）" Foreground="#888" />
                            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,8,8" BorderBrush="#DDD" BorderThickness="1" Padding="4">
                                            <StackPanel Width="160">
                                                <TextBlock HorizontalAlignment="Center" Margin="0,8,0,8" FontSize="40">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="📄" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Video">
                                                                    <Setter Property="Text" Value="📹" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="#666"
                                                           MaxWidth="152" TextTrimming="CharacterEllipsis" />
                                                <DockPanel Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#2B7FFF"
                                                               VerticalAlignment="Center" />
                                                    <button:CButton DockPanel.Dock="Right" Content="✕" Width="24" Height="20"
                                                                    HorizontalAlignment="Right" Click="RemoveAttachmentButton_Click" Tag="{Binding}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 选择文件（图/视频都可选）-->
                        <button:CButton Content="选择文件（图片/视频）" Width="170" Margin="0,12,0,0" HorizontalAlignment="Left"
                                        Click="PickFilesButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- Row2: 状态 + 提交 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="#666" TextTrimming="CharacterEllipsis" MaxWidth="600" />
                    <button:CButton Content="提交" Width="120" Click="SubmitButton_Click" />
                </StackPanel>
            </Grid>
        </controls:CLoadingOverlay>
    </Grid>
</Page>
