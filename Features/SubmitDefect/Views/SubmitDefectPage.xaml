<Page x:Class="PackageManager.Features.SubmitDefect.Views.SubmitDefectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:button="clr-namespace:CustomControlLibrary.CustomControl.Controls.Button;assembly=CustomControlLibrary"
      xmlns:controls="clr-namespace:CustomControlLibrary.CustomControl.Controls;assembly=CustomControlLibrary"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="Page_Loaded">
    <Grid>
        <controls:CLoadingOverlay x:Name="Overlay" Message="正在处理…"
                                  OverlayDarkness="0.25"
                                  AccentBrush="DodgerBlue">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="提交工作项" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 元数据行：类型 + 项目（只读） + 迭代（只读） -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <controls:CTextBlock Text="类型" Width="40" VerticalAlignment="Center" />
                    <controls:CComboBox Width="100" Height="32"
                              ItemsSource="{Binding TypeNames}"
                              SelectedItem="{Binding SelectedTypeName, Mode=TwoWay}" />
                    <controls:CTextBlock Text="项目" Width="40" Margin="20,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedProjectName, TargetNullValue=加载中…}" Width="180"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <controls:CTextBlock Text="迭代" Width="40" Margin="20,0,0,0" VerticalAlignment="Center" />
                    <controls:CComboBox Width="220" Height="32"
                              ItemsSource="{Binding Iterations}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedIteration, Mode=TwoWay}" />
                </StackPanel>

                <!-- 标题预览 -->
                <StackPanel Grid.Row="2" Margin="0,0,0,6">
                    <controls:CTextBlock Text="标题（自动提取首句）" Foreground="#888" />
                    <TextBlock Text="{Binding TitlePreview}" FontSize="14" FontWeight="SemiBold"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 粘贴区 -->
                <Border Grid.Row="3" BorderBrush="#CCC" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8"
                        AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                    <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding DescriptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="14" Padding="8"
                             PreviewKeyDown="PasteBox_PreviewKeyDown" TextChanged="PasteBox_TextChanged" />
                </Border>

                <!-- 示意图缩略图 -->
                <StackPanel Grid.Row="4" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <controls:CTextBlock Text="示意图（粘贴/拖拽图片自动归类）" Foreground="#888" VerticalAlignment="Center" />
                        <button:CButton Content="选择图片" Width="80" Margin="12,0,0,0" Click="PickImagesButton_Click" />
                        <button:CButton Content="清空图片" Width="80" Margin="8,0,0,0" Click="ClearImagesButton_Click" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Images}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" BorderBrush="#DDD" BorderThickness="1" Padding="4">
                                    <StackPanel Width="128">
                                        <Image Source="{Binding Thumbnail}" Width="120" Height="120" Stretch="Uniform" />
                                        <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="#666"
                                                   MaxWidth="120" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#2B7FFF"
                                                       VerticalAlignment="Center" />
                                            <button:CButton DockPanel.Dock="Right" Content="✕" Width="24" Height="20"
                                                            HorizontalAlignment="Right" Click="RemoveImageButton_Click" Tag="{Binding}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 状态 + 提交按钮 -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="#666" TextTrimming="CharacterEllipsis" />
                    <button:CButton Content="提交" Width="120" Click="SubmitButton_Click" />
                </StackPanel>
            </Grid>
        </controls:CLoadingOverlay>
    </Grid>
</Page>
