<Page x:Class="PackageManager.Features.MimoUsage.Views.MimoUsagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:button="clr-namespace:CustomControlLibrary.CustomControl.Controls.Button;assembly=CustomControlLibrary"
      xmlns:controls="clr-namespace:CustomControlLibrary.CustomControl.Controls;assembly=CustomControlLibrary"
      xmlns:C="clr-namespace:CustomControlLibrary.CustomControl.Controls.DataGrid;assembly=CustomControlLibrary"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="Page_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 隐藏的 WebView2 -->
        <wv2:WebView2 x:Name="ApiWeb" Grid.Row="0" Width="0" Height="0"
                      Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="MiMo Token 用量统计" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="StatusText" Text="" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#6B7280" FontSize="12" Margin="0,0,16,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="月份:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#374151" FontSize="13" />
                <button:CButton x:Name="PrevMonthBtn" Content="◀" Width="28" Height="28" Click="PrevMonth_Click" FontSize="12" />
                <TextBlock x:Name="MonthText" Text="" VerticalAlignment="Center" Width="80" TextAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                <button:CButton x:Name="NextMonthBtn" Content="▶" Width="28" Height="28" Click="NextMonth_Click" FontSize="12" />
            </StackPanel>
            <button:CButton Grid.Column="3" x:Name="LoginBtn" Content="登录" Width="80" Height="32" Margin="8,0,0,0" Click="Login_Click" Background="#2B7FFF" Foreground="White" FontSize="12" />
            <button:CButton Grid.Column="4" x:Name="RefreshBtn" Content="刷新" Width="80" Height="32" Click="Refresh_Click" Background="#10B981" Foreground="White" FontSize="12" />
        </Grid>

        <!-- 未登录提示 -->
        <Border x:Name="NotLoggedInPanel" Grid.Row="1" Background="#FFF7ED" BorderBrush="#FDBA74"
                BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" Visibility="Visible">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="HintText" Text="请先登录小米 MiMo 平台，点击上方「登录」按钮" VerticalAlignment="Center" Foreground="#92400E" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 套餐信息 -->
        <Border x:Name="PlanInfoPanel" Grid.Row="1" Background="#F0FDF4" BorderBrush="#BBF7D0"
                BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="PlanNameText" Text="" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#166534" />
                <TextBlock Grid.Column="1" x:Name="PlanPeriodText" Text="" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" Foreground="#166534" />
                <TextBlock Grid.Column="3" x:Name="PlanUsageText" Text="" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#166534" />
                <Grid Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
                    <Border Height="8" CornerRadius="4" Background="#DCFCE7" />
                    <Border x:Name="PlanUsageBar" Height="8" CornerRadius="4" Background="#22C55E" HorizontalAlignment="Left" Width="0" />
                </Grid>
            </Grid>
        </Border>

        <!-- 月度汇总 -->
        <Grid x:Name="SummaryPanel" Grid.Row="2" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="总消耗: " Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="TotalTokenText" Text="" FontWeight="Bold" Foreground="#1E40AF" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#F0FDF4" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="缓存命中: " Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="CacheHitText" Text="" FontWeight="Bold" Foreground="#166534" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#FEF2F2" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="缓存未中: " Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="CacheMissText" Text="" FontWeight="Bold" Foreground="#991B1B" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#FFFBEB" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="输出: " Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="OutputTokenText" Text="" FontWeight="Bold" Foreground="#92400E" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="#F5F3FF" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="请求数: " Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="TotalRequestText" Text="" FontWeight="Bold" Foreground="#6B21A8" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="5" Background="#ECFDF5" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="命中率: " Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="OverallHitRateText" Text="" FontWeight="Bold" Foreground="#166534" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 加载中提示 -->
        <StackPanel x:Name="LoadingPanel" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock x:Name="LoadingText" Text="正在加载数据..." HorizontalAlignment="Center" Foreground="#6B7280" FontSize="13" />
        </StackPanel>

        <!-- 每日明细表格（CDataGrid，自带滚动） -->
        <C:CDataGrid x:Name="UsageDataGrid" Grid.Row="4"
                     ItemsSource="{Binding DailyItems}"
                     TextAlignment="Left"
                     EnableAutoTemplateSelection="True"
                     VerticalScrollBarVisibility="Auto"
                     Visibility="Collapsed" />

        <!-- 按模型汇总 -->
        <Border x:Name="ModelSummaryBorder" Grid.Row="5" Margin="0,12,0,0"
                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                Background="#FAFBFC" Visibility="Collapsed">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="按模型汇总" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#374151" />
                <C:CDataGrid Grid.Row="1" x:Name="ModelSummaryGrid"
                             ItemsSource="{Binding ModelSummaryItems}"
                             TextAlignment="Left"
                             EnableAutoTemplateSelection="True"
                             VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <!-- 底部状态 -->
        <TextBlock Grid.Row="6" x:Name="FooterText" Text="" Margin="0,8,0,0" FontSize="11" Foreground="#9CA3AF" />
    </Grid>
</Page>
