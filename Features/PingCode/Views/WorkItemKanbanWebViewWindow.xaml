<Window x:Class="PackageManager.Views.KanBan.WorkItemKanbanWebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CustomControlLibrary.CustomControl.Controls;assembly=CustomControlLibrary"
        xmlns:button="clr-namespace:CustomControlLibrary.CustomControl.Controls.Button;assembly=CustomControlLibrary"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="迭代看板" Height="700" Width="1080"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏：筛选（WPF 下拉）+ 经典视图兜底入口 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,16,20,12">
            <TextBlock Text="迭代看板" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <controls:CTextBlock Text="人员" Width="50" VerticalAlignment="Center" />
                <controls:CComboBox Width="200" Height="35"
                                    ItemsSource="{Binding Members}"
                                    DisplayMemberPath="Name"
                                    SelectedItem="{Binding SelectedMember, Mode=TwoWay}" />
                <controls:CTextBlock Text="参与/关注者" Width="80" VerticalAlignment="Center" Margin="12,0,0,0" />
                <controls:CComboBox Width="220" Height="35"
                                    ItemsSource="{Binding Participants}"
                                    SelectedValue="{Binding SelectedParticipant, Mode=TwoWay}" />
            </StackPanel>
            <button:CButton Width="92" Height="35" Margin="16,0,0,0" Content="经典视图"
                            Click="ClassicViewButton_Click" ToolTip="切换到 WPF 经典看板（兜底）"/>
        </StackPanel>

        <wv2:WebView2 Grid.Row="1" x:Name="BoardWeb" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- 加载遮罩（普通 Grid，避开 CLoadingOverlay 的 name scope 限制） -->
        <Grid Grid.Row="1" x:Name="LoadingOverlay" Background="#E6FFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText" Text="正在加载看板…" FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
