<Window x:Class="PackageManager.Views.SecretChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:button="clr-namespace:CustomControlLibrary.CustomControl.Controls.Button;assembly=CustomControlLibrary"
        Title="密语"
        Width="540"
        Height="660"
        MinWidth="440"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#0F1513">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DataTemplate x:Key="SecretMessageTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 正常内容气泡 -->
                <Border x:Name="BubbleBorder"
                        Grid.Column="0"
                        MaxWidth="330"
                        Padding="11,9,11,7"
                        Background="#1D2A26"
                        CornerRadius="12,12,12,3"
                        HorizontalAlignment="Left">
                    <StackPanel x:Name="NormalContent">
                        <TextBlock Text="{Binding Text}" FontSize="14" Foreground="#F4FFF9" TextWrapping="Wrap"/>
                        <!-- 引信进度条 -->
                        <ProgressBar x:Name="FuseBar"
                                     Height="2"
                                     MinHeight="2"
                                     Margin="0,6,0,0"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding FuseProgress, Mode=OneWay}"
                                     Foreground="#2BC79A"
                                     Background="#243730"
                                     BorderThickness="0"
                                     Visibility="{Binding IsBurning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <!-- 元信息行：时间 + 状态 -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CreatedAtText}" Foreground="#5E7A70" FontSize="10.5" VerticalAlignment="Center"/>
                            <TextBlock Margin="8,0,0,0" Text="{Binding StateText}" Foreground="#6FDDBB" FontSize="10.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 灰烬占位 -->
                <Border x:Name="AshBorder"
                        Grid.Column="0"
                        Visibility="Collapsed"
                        Padding="11,7"
                        Background="Transparent"
                        BorderBrush="#33473F"
                        BorderThickness="1"
                        CornerRadius="10"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔥" FontSize="12" VerticalAlignment="Center" Opacity="0.55"/>
                        <TextBlock Margin="7,0,0,0" Text="此消息已销毁" Foreground="#6B8A7E" FontSize="11.5" FontStyle="Italic" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDestroyed}" Value="True">
                    <Setter TargetName="BubbleBorder" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="AshBorder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsIncomingUnread}" Value="True">
                    <Setter TargetName="BubbleBorder" Property="Background" Value="#23403A"/>
                    <Setter TargetName="BubbleBorder" Property="BorderBrush" Value="#35D9A6"/>
                    <Setter TargetName="BubbleBorder" Property="BorderThickness" Value="2.5,0.5,0.5,0.5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                    <Setter TargetName="BubbleBorder" Property="Grid.Column" Value="1"/>
                    <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="BubbleBorder" Property="Background" Value="#176F63"/>
                    <Setter TargetName="BubbleBorder" Property="CornerRadius" Value="12,12,3,12"/>
                    <Setter TargetName="AshBorder" Property="Grid.Column" Value="1"/>
                    <Setter TargetName="AshBorder" Property="HorizontalAlignment" Value="Right"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部：头像 + 对端信息 + 截图保护徽章 -->
        <Border Grid.Row="0" Padding="14,12" Background="#17211E" BorderBrush="#223230" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#245248"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding PeerInitial}" Foreground="#7CE8C4" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PeerDisplayName}" FontSize="15" FontWeight="Bold"
                               Foreground="#F3FFF9" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Margin="0,3,0,0" Text="{Binding ProtectionText}" Foreground="#5E7A70" FontSize="10.5"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border Grid.Column="2" Padding="9,5" CornerRadius="8" VerticalAlignment="Center"
                        Background="#1A2E28" BorderBrush="#2BC79A" BorderThickness="1"
                        Visibility="{Binding IsProtected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Margin="5,0,0,0" Text="截图黑屏" Foreground="#7CE8C4" FontSize="10.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 消息区 -->
        <Border Grid.Row="1" Margin="10" Padding="6" Background="#0B0E0D" CornerRadius="14">
            <ScrollViewer x:Name="MessagesScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl x:Name="MessagesItemsControl"
                              ItemsSource="{Binding Messages}"
                              ItemTemplate="{StaticResource SecretMessageTemplate}"/>
            </ScrollViewer>
        </Border>

        <!-- 输入区 -->
        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageTextBox"
                     MinHeight="42"
                     MaxHeight="96"
                     MaxLength="2000"
                     Padding="11,10"
                     FontSize="14"
                     Background="#0E1513"
                     BorderBrush="#2A3B35"
                     BorderThickness="1"
                     Foreground="#F4FFF9"
                     CaretBrush="#2BC79A"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     VerticalScrollBarVisibility="Auto"
                     ContextMenu="{x:Null}"
                     PreviewKeyDown="MessageTextBox_PreviewKeyDown"/>
            <button:CButton Grid.Column="1"
                            Width="84"
                            Height="42"
                            Margin="10,0,0,0"
                            Content="发送"
                            Click="SendButton_Click"/>
        </Grid>

        <!-- 失焦遮蔽（不透明，彻底遮挡消息内容） -->
        <Border x:Name="PrivacyOverlay"
                Grid.RowSpan="3"
                Background="#FF0B0E0D"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🔒" FontSize="34" Opacity="0.5" HorizontalAlignment="Center"/>
                <TextBlock Margin="0,10,0,0" Text="密语已遮蔽" Foreground="#7C8A84" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Margin="0,6,0,0" Text="已读消息在失焦时立即焚毁 · 未读消息保留" Foreground="#4E5C56" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
