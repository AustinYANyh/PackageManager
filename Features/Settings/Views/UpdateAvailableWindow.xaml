<Window x:Class="PackageManager.Features.Settings.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:button="clr-namespace:CustomControlLibrary.CustomControl.Controls.Button;assembly=CustomControlLibrary"
        Title="发现新版本"
        Width="480"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Border x:Name="RootBorder" Margin="16" Background="White" CornerRadius="12"
            BorderBrush="#E5E7EB" BorderThickness="1"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#0F172A" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 头部：标题 + 版本对比 -->
            <Border Grid.Row="0" Padding="24,22,20,18" CornerRadius="12,12,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F0F6FF" Offset="0" />
                        <GradientStop Color="#FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#2B7FFF"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="发现新版本" FontSize="17" FontWeight="Bold" Foreground="#111827" />
                            <TextBlock Text="PackageManager 自动更新" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2" x:Name="CloseButton" Width="28" Height="28"
                                Cursor="Hand" Click="CloseButton_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseBorder" Background="Transparent" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBorder" Property="Background" Value="#F3F4F6" />
                                            <Setter TargetName="CloseBorder" Property="TextBlock.Foreground" Value="#374151" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- 版本徽章行 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                        <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="13"
                                Height="26" Padding="12,0">
                            <TextBlock x:Name="CurrentVersionText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#6B7280" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="→" FontSize="14" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0" />
                        <Border Background="#EBF3FF" BorderBrush="#BFD7FF" BorderThickness="1" CornerRadius="13"
                                Height="26" Padding="12,0">
                            <TextBlock x:Name="LatestVersionText" FontSize="13" FontWeight="Bold"
                                       Foreground="#2B7FFF" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="ReleaseNoteText" FontSize="12" Foreground="#9CA3AF"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 更新点时间线 -->
            <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto" Padding="24,16,20,14">
                <StackPanel x:Name="ChangeGroupsPanel" />
            </ScrollViewer>

            <!-- 底部操作区 -->
            <Border Grid.Row="2" Padding="24,14,24,20" CornerRadius="0,0,12,12" Background="#FAFBFC"
                    BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 失败错误条 -->
                    <Border Grid.Row="0" x:Name="ErrorBar" Visibility="Collapsed" Margin="0,0,0,12"
                            Padding="12,10" CornerRadius="8" Background="#FEF2F2" BorderBrush="#FECACA"
                            BorderThickness="1">
                        <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#B91C1C"
                                   TextWrapping="Wrap" LineHeight="18" />
                    </Border>

                    <!-- 待机操作 -->
                    <StackPanel Grid.Row="1" x:Name="ActionsPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <button:CButton Grid.Column="0" x:Name="UpdateButton" Content="立即更新"
                                            Height="36" FontSize="14" FontWeight="SemiBold"
                                            Background="#2B7FFF" Foreground="White"
                                            Click="UpdateButton_Click" />
                            <button:CButton Grid.Column="1" x:Name="LaterButton" Content="稍后提醒"
                                            Height="36" FontSize="13" Margin="10,0,0,0"
                                            Background="White" Foreground="#6B7280"
                                            Click="LaterButton_Click" />
                            <Button Grid.Column="2" x:Name="SkipButton" Content="跳过此版本"
                                    Margin="10,0,0,0" Cursor="Hand" VerticalAlignment="Center"
                                    FontSize="12" Foreground="#9CA3AF" Click="SkipButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="4,2">
                                            <TextBlock x:Name="SkipText" Text="跳过此版本" FontSize="12"
                                                       Foreground="#9CA3AF" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SkipText" Property="Foreground" Value="#6B7280" />
                                                <Setter TargetName="SkipText" Property="TextDecorations" Value="Underline" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 下载进度 -->
                    <StackPanel Grid.Row="1" x:Name="ProgressPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="SpeedText" FontSize="12" Foreground="#6B7280" />
                            <TextBlock Grid.Column="1" x:Name="PercentText" FontSize="12" FontWeight="Bold"
                                       Foreground="#2B7FFF" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="EtaText" FontSize="12" Foreground="#6B7280" />
                        </Grid>
                        <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="100"
                                     Foreground="#2B7FFF" Background="#E5E7EB" BorderThickness="0" />
                        <TextBlock x:Name="ProgressNote" FontSize="12" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" Text="正在下载新版本…" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
